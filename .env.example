# ============================================
# ATM Backend - Environment Configuration
# ============================================

# Environment: true = production, false = development
ATM_PRODUCTION=false

# ============================================
# Database (PostgreSQL/Supabase)
# ============================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/atm
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-db-password

# In alternative su Render/hosting simili puoi usare DATABASE_URL non JDBC:
# DATABASE_URL=postgresql://postgres:your-db-password@db.ydrvnqjagyxaigkucrab.supabase.co:5432/postgres

# ============================================
# Security
# ============================================

# JWT Secret (min 32 chars, CHANGE IN PRODUCTION!)
ATM_JWT_SECRET=change-me-change-me-change-me-change-me

# Internal API Key for BE.CHAT -> BE communication (CHANGE IN PRODUCTION!)
ATM_INTERNAL_API_KEY=atm-internal-secret-key-change-in-prod

# Max PIN attempts before card is blocked
ATM_MAX_PIN_ATTEMPTS=3

# ============================================
# CORS Allowed Origins (comma-separated)
# ============================================
# Dev: http://localhost:*,https://localhost:*
# Prod: add your GitHub Pages URL, e.g.:
# ATM_CORS_ORIGINS=https://yourusername.github.io,http://localhost:*
ATM_CORS_ORIGINS=http://localhost:*,https://localhost:*

# ============================================
# Demo Data
# ============================================
# Enable demo seed data (disable in production)
ATM_SEED_ENABLED=true

# ============================================
# Server
# ============================================
SERVER_PORT=8080
